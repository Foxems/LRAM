<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <!-- A small foreground app: no background GC thread, smaller heap. -->
    <gcConcurrent enabled="false"/>
    <gcServer enabled="false"/>
  </runtime>
</configuration>
