                                <Button x:Name="LaunchButton" Grid.Column="1" Style="{StaticResource AccentButton}" Height="36" MinWidth="140" Margin="16,0,0,0" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
