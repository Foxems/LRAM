                                                                    <TextBlock x:Name="TriesValue" Width="46" TextAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Button x:Name="TriesPlus" Style="{StaticResource StepBtn}"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="{DynamicResource IconSize11}"/></Button>
