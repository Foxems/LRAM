                                    <TextBlock x:Name="SectionCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="1,2,0,2"/>
                        <StackPanel x:Name="SecLaunching" Tag="Launching" Visibility="Collapsed">
                            <TextBlock Tag="head" Text="Launching" Style="{StaticResource SectionLabel}" Visibility="Collapsed" Margin="0,22,0,2"/>
