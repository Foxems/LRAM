                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,22,24,22">
                        <TextBlock x:Name="DlgTitle" Style="{StaticResource Subtitle}"/>
