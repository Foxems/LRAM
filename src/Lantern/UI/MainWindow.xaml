                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                               ui:Rich.Markup="Lantern holds the same lock Roblox uses to stay single-instance, so **every account can open its own window**. **Close Roblox** before turning this on."/>
                                                                    <StackPanel x:Name="MultiStatusRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
