                                <StackPanel x:Name="ErrorsContent" Margin="14,0,28,40" MaxWidth="760" HorizontalAlignment="Left" RenderTransformOrigin="0,0">
                                    <StackPanel.RenderTransform><TranslateTransform x:Name="ErrorsContentShift" Y="0"/></StackPanel.RenderTransform>
                                    <TextBlock x:Name="ErrorsTitle" Style="{StaticResource Subtitle}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ErrorsCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="1,2,0,6" TextTrimming="None"/>
                                    <StackPanel x:Name="ErrorsBody"/>
                                    <StackPanel x:Name="ErrorsNoResults" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="440" HorizontalAlignment="Left">
                                        <TextBlock Text="Nothing found" Style="{StaticResource Subtitle}"/>
                                        <TextBlock x:Name="ErrorsNoResultsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" TextTrimming="None"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

