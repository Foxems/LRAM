                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,24,0">
                                                                    <TextBlock Text="Cap the memory of minimized windows"/>
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                               ui:Rich.Markup="A minimized window may keep **at most the ceiling below** in RAM. Windows trims it at once and holds it there; the rest waits in compressed memory or the paging file and comes back page by page if the game needs it. Restoring a window lifts the ceiling within a second. It only applies to windows that are minimized and have finished loading. Too low a ceiling can make a window hitch or drop its connection, so **start high and go lower** while watching it. Keep Windows' paging file on **automatic or large**. What Roblox has reserved does not shrink, nothing inside Roblox is read or changed, and the ceiling ends with the window. **Off by default.**"/>
                                                                    <TextBlock x:Name="CapEstimate" Style="{StaticResource CaptionTertiary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                                <CheckBox x:Name="CapSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"/>
