                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SignInHelp" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource BrushTextSecondary}"
                                       Text="A private Roblox window opens. Sign in as usual — two-step verification works. Lantern keeps only the session, never your password, and the window forgets everything when it closes."/>
                            <CheckBox x:Name="KeepAdding" Content="Open it again afterwards so I can add the next one" Margin="0,14,0,0"/>
                            <StackPanel x:Name="CookiePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Cookies — one per line" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <Button x:Name="PasteClipboardButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" MinHeight="26" Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="{DynamicResource IconSize12}"/>
                                            <TextBlock Text="Paste from clipboard" Margin="7,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
