                                                                           Foreground="{DynamicResource BrushWarning}"/>
                                                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="13"
                                                                           Text="Having several accounts is fine under Roblox's rules. Running them in separate windows relies on a lock Roblox could change in any update — if that happens, launches will say so. Lantern never reads or edits Roblox's memory or program files."/>
                                                            </Grid>
                                                        </Border>
                            <Border ui:Ui.Keywords="stagger wait seconds rate limit" Style="{StaticResource SettingRow}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,24,0">
                                                                    <TextBlock Text="Delay between launches"/>
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
