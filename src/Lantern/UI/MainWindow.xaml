<Window x:Class="Lantern.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lantern.UI"
        xmlns:core="clr-namespace:Lantern.Core"
        Title="Lantern" Width="1040" Height="680" MinWidth="520" MinHeight="460" AllowDrop="True"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource BaseFontSize}" Foreground="{DynamicResource BrushText}"
        TextOptions.TextFormattingMode="{DynamicResource TextMode}"
        WindowStartupLocation="CenterScreen" Icon="/Lantern;component/Assets/lantern.ico">

    <Window.Resources>
        <ui:BoolVis x:Key="BoolVis"/>
        <ui:BoolVis x:Key="NotVis" Invert="True"/>

        <!-- Status dot: colour follows the account's state -->
        <Style x:Key="StatusDot" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
            <Setter Property="Background" Value="{DynamicResource BrushTextTertiary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Background" Value="{DynamicResource BrushSuccess}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="busy"><Setter Property="Background" Value="{DynamicResource BrushAccent}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="bad"><Setter Property="Background" Value="{DynamicResource BrushDanger}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowSurface" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrushRowHover}"/></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource BrushAccentSubtle}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Avatar with initial fallback -->
        <DataTemplate x:Key="AvatarTemplate" DataType="{x:Type core:AccountItem}">
            <Grid Width="38" Height="38">
                <Border CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource BrushControlHover}"/>
                <TextBlock Text="{Binding Initial}" Style="{StaticResource Strong}" FontSize="15" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}"
                           Visibility="{Binding HasAvatar, Converter={StaticResource NotVis}}"/>
                <Border CornerRadius="{DynamicResource RadiusPill}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Border CornerRadius="{DynamicResource RadiusPill}" BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AccountRow" DataType="{x:Type core:AccountItem}">
            <Border Height="{Binding Source={x:Static ui:LayoutState.Current}, Path=RowHeight}" Style="{StaticResource RowSurface}">
                <Grid>
                    <Grid Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="1.4*" MinWidth="130"/>
                            <ColumnDefinition Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=StatusColumn}"/>
                            <ColumnDefinition Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=GameColumn}"/>
                            <ColumnDefinition Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=ActionColumn}"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Include in the next launch"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Background="Transparent" ToolTip="Drag to change the order"
                                    ToolTipService.InitialShowDelay="1200">
                            <ContentPresenter ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Display}" Style="{StaticResource Strong}"/>
                                <TextBlock Text="{Binding Tagline}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" ToolTip="{Binding FullStatusTip}" Tag="status" Background="Transparent"
                                            Visibility="{Binding Source={x:Static ui:LayoutState.Current}, Path=CompactVisibility}">
                                    <Border Style="{StaticResource StatusDot}" Width="7" Height="7"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" FontSize="12" Margin="7,0,0,0" MaxWidth="190"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Visibility="{Binding Source={x:Static ui:LayoutState.Current}, Path=StatusVisibility}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullStatusTip}" Background="Transparent" Tag="status">
                                <Border Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" MaxWidth="{Binding Source={x:Static ui:LayoutState.Current}, Path=StatusTextMax}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource CaptionTertiary}" FontSize="11.5" Margin="17,3,0,0" MaxWidth="{Binding Source={x:Static ui:LayoutState.Current}, Path=UsageTextMax}"
                                       Visibility="{Binding HasUsage, Converter={StaticResource BoolVis}}" ToolTip="Live use of this window: CPU (share of the whole PC), graphics card, memory"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding LastGame}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                   Visibility="{Binding Source={x:Static ui:LayoutState.Current}, Path=GameVisibility}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Tag="action" MinHeight="30" Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=ActionWidth}" Padding="0" IsEnabled="{Binding CanAct}" ToolTip="{Binding ActionLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding ActionGlyph}" FontSize="{DynamicResource IconSize12}"/>
                                    <TextBlock Text="{Binding ActionLabel}" Margin="8,0,0,0" Visibility="{Binding Source={x:Static ui:LayoutState.Current}, Path=LabelVisibility}"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="more" Style="{StaticResource IconButton}" Width="32" Height="30" Margin="6,0,0,0" ToolTip="More">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BrushStroke}"
                               Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameRow" DataType="{x:Type core:GameItem}">
            <Border Height="64" Style="{StaticResource RowSurface}">
                <Grid>
                    <Grid Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40" VerticalAlignment="Center">
                                <Border CornerRadius="{DynamicResource RadiusLg}" Background="{DynamicResource BrushControlHover}">
                                    <TextBlock Text="{Binding Initial}" Style="{StaticResource Strong}" FontSize="16" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}"
                                               Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                                </Border>
                                <Border CornerRadius="{DynamicResource RadiusLg}">
                                    <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background>
                                </Border>
                                <Border CornerRadius="{DynamicResource RadiusLg}" BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1"/>
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Tag="use" MinHeight="30" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="{DynamicResource IconSize12}"/>
                                    <TextBlock Text="Use" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="remove" Style="{StaticResource IconButton}" Width="32" Height="30" Margin="6,0,0,0" ToolTip="Remove">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BrushStroke}"
                               Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProfileRow" DataType="{x:Type core:ProfileItem}">
            <Border Height="68" Style="{StaticResource RowSurface}">
                <Grid>
                    <Grid Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="{DynamicResource RadiusXl}" VerticalAlignment="Center" Background="{DynamicResource BrushAccentSubtle}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="{DynamicResource IconSize16}" Foreground="{DynamicResource BrushAccentText}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Tag="run" MinHeight="30" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="{DynamicResource IconSize12}"/>
                                    <TextBlock Text="Launch" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="more" Style="{StaticResource IconButton}" Width="32" Height="30" Margin="6,0,0,0" ToolTip="More">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BrushStroke}"
                               Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings row -->
        <Style x:Key="SettingTitle" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushStroke}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,16"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Strong}">
            <Setter Property="Margin" Value="0,30,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
        </Style>
        <Style x:Key="StepBtn" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- ============================ SHELL ============================ -->
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Grid x:Name="NavRail">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                    <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" ToolTip="Accounts">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Accounts" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Launch profiles">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Profiles" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Saved games">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Games" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPulse" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Pulse: are the windows really in a game, how often they drop, how long each account was online, and what your settings cost">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Pulse" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLive" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Live: every running window in one grid, to watch, play, pause or close">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Live" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <RadioButton x:Name="NavErrors" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Errors: what Roblox's disconnect codes mean and what Lantern does about each one">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Errors" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCredits" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Credits: who made Lantern, and where to find the source and the author">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEB51;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Credits" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Settings">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontFamily="{DynamicResource FontRailIcons}" FontSize="{DynamicResource RailIconSize}"/>
                            </Grid>
                            <TextBlock Text="Settings" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Border Grid.Column="1" x:Name="ContentPane" Background="{DynamicResource BrushLayer}" CornerRadius="{DynamicResource RadiusPaneTL}"
                    BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1,1,0,0" ClipToBounds="True">
                <Grid>

                    <!-- ===================== ACCOUNTS ===================== -->
                    <Grid x:Name="PageAccounts">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeaderGrid" Margin="28,24,28,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="Accounts" Style="{StaticResource Title}"/>
                                </Grid>
                                <TextBlock x:Name="AccountsSummary" Style="{StaticResource Caption}" Margin="1,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="HeaderControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid x:Name="SearchHost" Width="200">
                                    <TextBox x:Name="SearchBox" ui:Ui.Placeholder="Search" Padding="32,0,10,0"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="{DynamicResource IconSize13}" HorizontalAlignment="Left" Margin="11,0,0,0"
                                               Foreground="{DynamicResource BrushTextTertiary}" IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="TileButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Tile running windows">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;"/>
                                </Button>
                                <Button x:Name="CloseAllButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="Close all running windows">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;"/>
                                </Button>
                                <Button x:Name="AddButton" Style="{StaticResource AccentButton}" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="{DynamicResource IconSize13}"/>
                                        <TextBlock Text="Add account" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Group chips -->
                        <Grid x:Name="GroupBar" Grid.Row="1" Margin="28,0,28,6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel x:Name="GroupChips" VerticalAlignment="Top"/>
                            <Button x:Name="NewGroupButton" Grid.Column="1" Style="{StaticResource SubtleButton}" MinHeight="28" Height="28" Padding="10,0"
                                    VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Put the ticked accounts in a group">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="{DynamicResource IconSize11}"/>
                                    <TextBlock Text="Group" Margin="7,0,0,0" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Suggestion (appears only when something is limiting this PC) -->
                        <Border x:Name="AdviceBar" Grid.Row="2" Margin="28,2,28,10" Padding="12,9" CornerRadius="{DynamicResource RadiusLg}" Visibility="Collapsed"
                                Background="{DynamicResource BrushAccentSubtle}" BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" FontSize="{DynamicResource IconSize16}" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushAccentText}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AdviceTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AdviceDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button x:Name="AdviceApply" Grid.Column="2" Margin="14,0,0,0" MinHeight="30" Padding="14,0" VerticalAlignment="Center"/>
                                <Button x:Name="AdviceClose" Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Dismiss">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="{DynamicResource IconSize12}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Column header -->
                        <Grid x:Name="ListHeader" Grid.Row="3" Height="34">
                            <Grid Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="1.4*" MinWidth="130"/>
                                    <ColumnDefinition Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=StatusColumn}"/>
                                    <ColumnDefinition Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=GameColumn}"/>
                                    <ColumnDefinition Width="{Binding Source={x:Static ui:LayoutState.Current}, Path=ActionColumn}"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SelectAll" IsThreeState="True" IsChecked="False" VerticalAlignment="Center" ToolTip="Select all"/>
                                <Button x:Name="SortButton" Grid.Column="1" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        MinHeight="26" Height="26" Padding="8,0" Margin="-8,0,0,0" ToolTip="Sort the list. You can also drag any row to put it where you want.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Account" Style="{StaticResource Caption}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="{DynamicResource IconSize9}" Margin="6,1,0,0" Foreground="{DynamicResource BrushTextTertiary}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Visibility="{Binding Source={x:Static ui:LayoutState.Current}, Path=StatusVisibility}"/>
                                <TextBlock Grid.Column="3" Text="Last game" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Visibility="{Binding Source={x:Static ui:LayoutState.Current}, Path=GameVisibility}"/>
                            </Grid>
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BrushStroke}"
                                       Margin="{Binding Source={x:Static ui:LayoutState.Current}, Path=Gutter}"/>
                        </Grid>

                        <Grid x:Name="AccountsHost" Grid.Row="4" AllowDrop="True" Background="{DynamicResource BrushBackdropVeil}">
                            <ScrollViewer x:Name="AccountsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AccountsList" ItemTemplate="{StaticResource AccountRow}" Focusable="False"/>
                            </ScrollViewer>
                            <Border x:Name="DropLine" Height="3" CornerRadius="1.5" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                    Background="{DynamicResource BrushAccent}" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="5"/>

                            <StackPanel x:Name="AccountsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Visibility="Collapsed">
                                <TextBlock Text="No accounts yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18" FontSize="13"
                                           Text="Sign in once and Lantern remembers each session — encrypted, on this PC only. Got a list of cookies? Paste them all at once, or just press Ctrl+V."/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="EmptyAddButton" Style="{StaticResource AccentButton}" Padding="18,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="{DynamicResource IconSize14}"/>
                                            <TextBlock Text="Sign in" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EmptyPasteButton" Padding="18,0" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="{DynamicResource IconSize14}"/>
                                            <TextBlock Text="Paste cookies" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="NoMatches" Text="Nothing matches your search." Style="{StaticResource Caption}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Launch bar -->
                        <Border Grid.Row="5" x:Name="LaunchBar" Background="{DynamicResource BrushLayerAlt}" BorderBrush="{DynamicResource BrushStroke}"
                                BorderThickness="0,1,0,0" Padding="28,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="LaunchFields">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TargetBox" ui:Ui.Placeholder="Place ID, game link or private server link" MinHeight="36"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button x:Name="LibraryButton" Style="{StaticResource IconButton}" Height="36" Width="36" ToolTip="Saved games">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;"/>
                                        </Button>
                                        <Button x:Name="FindPlayerButton" Style="{StaticResource IconButton}" Height="36" Width="36" ToolTip="Join a player by username">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;"/>
                                        </Button>
                                        <Button x:Name="SaveProfileButton" Style="{StaticResource IconButton}" Height="36" Width="36" ToolTip="Save the ticked accounts + this game as a profile">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;"/>
