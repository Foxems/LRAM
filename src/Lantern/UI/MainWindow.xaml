        <!-- ============================ SAVED GAMES POPUP ============================ -->
        <Popup x:Name="LibraryPopup" PlacementTarget="{Binding ElementName=LibraryButton}" Placement="Top" VerticalOffset="-8" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Effect="{DynamicResource EffectPopup}" Margin="10" Width="340" MaxHeight="360" CornerRadius="{DynamicResource RadiusLg}" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushSurfaceStroke}" BorderThickness="1" Padding="4">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LibraryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:GameItem}">
                                    <Button Tag="pick" Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="30" Height="30">
                                                <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource BrushControlHover}">
                                                    <TextBlock Text="{Binding Initial}" Style="{StaticResource Strong}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource BrushTextSecondary}" Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                                                </Border>
                                                <Border CornerRadius="{DynamicResource RadiusMd}"><Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background></Border>
                                            </Grid>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="LibraryEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="14,16" FontSize="13"
                               Text="No saved games yet. Add some on the Games page."/>
                </Grid>
            </Border>
        </Popup>

        <!-- ============================ TOAST ============================ -->
        <Border x:Name="Toast" Effect="{DynamicResource EffectToast}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="90,0,14,118" Padding="14,10" CornerRadius="{DynamicResource RadiusLg}"
                Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushSurfaceStroke}" BorderThickness="1" MaxWidth="560"
                Visibility="Collapsed" Opacity="0" Panel.ZIndex="60" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
