                                         VerticalScrollBarVisibility="Auto" ui:Ui.Placeholder="Paste cookies here — or drop a .txt file on the window"/>
                                <TextBlock x:Name="CookieCount" Style="{StaticResource Caption}" Margin="1,8,0,0"/>
                                <TextBlock Style="{StaticResource CaptionTertiary}" TextWrapping="Wrap" Margin="1,6,0,0"
                                           Text="Anyone with a cookie can act as that account, so never share one. Lantern keeps it encrypted on this PC and sends it only to roblox.com."/>
                            </StackPanel>
                            <TextBlock x:Name="DlgError" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource BrushDanger}" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BrushLayerAlt}" BorderBrush="{DynamicResource BrushStroke}" BorderThickness="0,1,0,0"
                            CornerRadius="{DynamicResource RadiusBottomLg}" Padding="24,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DlgCancel" Content="Cancel" MinWidth="96"/>
                            <Button x:Name="DlgOk" Style="{StaticResource AccentButton}" MinWidth="110" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
