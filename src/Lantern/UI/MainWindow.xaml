            <Border x:Name="DialogCard" Effect="{DynamicResource EffectDialog}" MaxWidth="500" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="20" CornerRadius="{DynamicResource RadiusLg}"
                    Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushSurfaceStroke}" BorderThickness="1">
                <Grid>
