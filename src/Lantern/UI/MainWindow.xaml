                                                                </Border>
                                                            </Grid>
                                                        </Border>
                        </StackPanel>
                        <StackPanel x:Name="SecOnline" Tag="Online" Visibility="Collapsed">
                            <TextBlock Tag="head" Text="Staying online" Style="{StaticResource SectionLabel}" Visibility="Collapsed" Margin="0,22,0,2"/>
                            <Border ui:Ui.Keywords="rejoin reconnect restart crash kicked disconnect error maintenance 275 auto-rejoin" Style="{StaticResource SettingRow}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,24,0">
                                                                    <TextBlock Text="Rejoin when a window closes"/>
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                               ui:Rich.Markup="If a window crashes, or Roblox disconnects it and leaves it on an error screen (server shut down, Roblox maintenance, lost connection, kicked…), Lantern **closes it and joins again**. Closing a window from Lantern **never** triggers this. The Errors page lists every code."/>
                                                                </StackPanel>
                                                                <CheckBox x:Name="RejoinSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                            </Grid>
                                                        </Border>
                            <Border ui:Ui.Keywords="idle afk 278 twenty minutes kick" Style="{StaticResource SettingRow}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,24,0">
                                                                    <TextBlock Text="Rejoin after an idle kick"/>
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                               ui:Rich.Markup="After **20 minutes** without input Roblox removes an account but leaves its window open on an error screen. When Roblox's own log clearly shows that kick, Lantern **closes the window and rejoins** the game. Other kicks and lag are left alone."/>
