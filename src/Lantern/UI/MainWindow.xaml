                    <!-- ===================== GAMES ===================== -->
                    <Grid x:Name="PageGames" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="28,24,28,16">
                            <Grid>
                                <TextBlock Text="Games" Style="{StaticResource Title}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="1,2,0,0" Text="Places you farm often. Pick one and it fills the launch bar."/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="28,0,28,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameAddBox" ui:Ui.Placeholder="Place ID or game link" MinHeight="36"/>
                            <Button x:Name="GameAddButton" Grid.Column="1" Style="{StaticResource AccentButton}" Height="36" Margin="10,0,0,0" Padding="18,0">
                                <TextBlock Text="Add"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource GameRow}" Focusable="False" VerticalAlignment="Top" Background="{DynamicResource BrushBackdropVeil}"/>
                            </ScrollViewer>
                            <TextBlock x:Name="GamesEmpty" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,36,0,0" Text="Nothing saved yet. Paste a game link above to keep it handy."/>
                        </Grid>
                    </Grid>

                    <!-- ===================== PROFILES ===================== -->
                    <Grid x:Name="PageProfiles" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="28,24,28,16">
                            <Grid>
                                <TextBlock Text="Profiles" Style="{StaticResource Title}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="1,2,0,0"
                                       Text="A profile remembers which accounts go into which game. One click starts the whole crew."/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="28,0,28,16" Orientation="Horizontal">
                            <Button x:Name="SaveCurrentProfileButton" Style="{StaticResource AccentButton}" Height="36" Padding="16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="{DynamicResource IconSize13}"/>
                                    <TextBlock Text="Save current selection as a profile" Margin="9,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ProfilesList" ItemTemplate="{StaticResource ProfileRow}" Focusable="False" VerticalAlignment="Top" Background="{DynamicResource BrushBackdropVeil}"/>
                            </ScrollViewer>
                            <StackPanel x:Name="ProfilesEmpty" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="420" Margin="0,30,0,0">
                                <TextBlock Text="No profiles yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" FontSize="13"
                                           Text="On the Accounts page, tick the accounts, put a game in the launch bar, then press the save icon next to it (or the button above)."/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===================== PULSE ===================== -->
                    <ScrollViewer x:Name="PagePulse" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PulseRoot" Margin="28,24,28,40" MaxWidth="980" HorizontalAlignment="Stretch">
                            <Grid>
                                <TextBlock Text="Pulse" Style="{StaticResource Title}"/>
                            </Grid>
                            <TextBlock x:Name="PulseCaption" Style="{StaticResource Caption}" Margin="1,2,0,0" TextWrapping="Wrap"
                                       Text="Is every window really inside a game, how often do they drop, and do your memory settings cost stability? Read from Roblox's own logs and Lantern's records only."/>
                            <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource BrushControl}" BorderBrush="{DynamicResource BrushControlStroke}"
                                    BorderThickness="1" Padding="2" Margin="0,16,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PulseViewOverview" Style="{StaticResource Segment}" GroupName="pulseview" Content="Overview" IsChecked="True"
                                                 ToolTip="Is every window in a game, how often they drop, what Lantern had to fix, and whether your settings cost stability"/>
                                    <RadioButton x:Name="PulseViewUptime" Style="{StaticResource Segment}" GroupName="pulseview" Content="Uptime"
                                                 ToolTip="How long each account was online, per game, and the latest sessions"/>
                                    <RadioButton x:Name="PulseViewBoard" Style="{StaticResource Segment}" GroupName="pulseview" Content="Board"
                                                 ToolTip="One square per account, without names: a picture of the farm to share"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel x:Name="PulseRangeRow" Margin="0,12,0,0">
                                <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource BrushControl}" BorderBrush="{DynamicResource BrushControlStroke}"
                                        BorderThickness="1" Padding="2" Margin="0,0,10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="PulseR1" Style="{StaticResource Segment}" GroupName="pulserange" Content="1 hour"/>
                                        <RadioButton x:Name="PulseR24" Style="{StaticResource Segment}" GroupName="pulserange" Content="24 hours"/>
                                        <RadioButton x:Name="PulseR7" Style="{StaticResource Segment}" GroupName="pulserange" Content="7 days"/>
                                        <RadioButton x:Name="PulseR30" Style="{StaticResource Segment}" GroupName="pulserange" Content="30 days"/>
                                        <RadioButton x:Name="PulseRAll" Style="{StaticResource Segment}" GroupName="pulserange" Content="All time" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="PulseCopyButton" Content="Copy as image" Margin="0,0,8,6"/>
                                <Button x:Name="PulseSaveButton" Content="Save image…" Margin="0,0,8,6"/>
                                <Button x:Name="StatsExportButton" Content="Export CSV…" Margin="0,0,8,6" Visibility="Collapsed"/>
                                <Button x:Name="StatsClearButton" Content="Clear history…" Margin="0,0,0,6" Visibility="Collapsed"/>
                            </WrapPanel>
                            <StackPanel x:Name="PulseOverviewPane">
                                <StackPanel x:Name="PulseBody" Margin="0,6,0,0"/>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0,1,0,0" Margin="0,26,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0">
                                            <TextBlock Text="Keep a report file"/>
                                            <TextBlock x:Name="PulseReportCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <Button x:Name="PulseFolderButton" Content="Open the folder" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PulseReportSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="StatsBody" Visibility="Collapsed" Margin="0,6,0,0"/>
                            <StackPanel x:Name="StatsLivePane" Visibility="Collapsed" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== LIVE ===================== -->
                    <Grid x:Name="PageLive" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="LiveHeader" Margin="28,24,20,8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Live" Style="{StaticResource Title}"/>
                                    </Grid>
                                    <TextBlock x:Name="LivePageCaption" Style="{StaticResource Caption}" Margin="1,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <Button x:Name="LiveStream" Margin="0,0,14,6" ToolTip="For sharing this window on Discord or OBS: blur account names, hide the left panel and the program name">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="{DynamicResource IconSize13}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="LiveStreamLabel" Text="Stream mode"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="{DynamicResource IconSize10}" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="LiveHideTaskbar" Content="Hide from taskbar" VerticalAlignment="Center" Margin="0,0,14,6"
                                              ToolTip="Takes the Roblox windows' buttons off the taskbar while Lantern runs; reach them through these tiles. Alt+Tab still lists them."/>
                                    <CheckBox x:Name="LiveShowOffline" Content="Show sleeping accounts" VerticalAlignment="Center" Margin="0,0,14,6"
                                              ToolTip="Accounts that aren't online sit in the grid as sleeping tiles: click one to start it. Turn off to see running windows only."/>
                                    <CheckBox x:Name="LiveTrim" Content="Trim memory" VerticalAlignment="Center" Margin="0,0,14,6"
                                              ToolTip="About once a minute, each open window hands its idle memory back to Windows, one window at a time. No limit: the game takes straight back what it uses (a short hitch right after), so only what it really doesn't use stays off. The side panel shows how much that is. Skips the window you're playing and windows still loading."/>
                                    <Button x:Name="LiveLaunch" Margin="0,0,8,6" ToolTip="Start a launch profile">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="{DynamicResource IconSize13}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Launch"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="{DynamicResource IconSize10}" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LivePauseAll" Margin="0,0,8,6" ToolTip="Minimise every window: they stop drawing and their tiles freeze">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="{DynamicResource IconSize13}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Pause all"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LiveResumeAll" Margin="0,0,0,6" ToolTip="Bring every paused window back behind Lantern so its tile is live again">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="{DynamicResource IconSize13}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Resume all"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                            <Grid x:Name="LiveArea" Grid.Row="2" Margin="28,0,20,12">
                                <WrapPanel x:Name="LiveTiles" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                <Border x:Name="LiveEmpty" Visibility="Collapsed" CornerRadius="{DynamicResource RadiusLg}" BorderThickness="1" Padding="32,36"
                                        Background="{DynamicResource BrushControl}" BorderBrush="{DynamicResource BrushControlStroke}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="0,0,0,40">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource BrushControlStroke}" HorizontalAlignment="Center"
                                                >
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="{DynamicResource IconSize24}" Foreground="{DynamicResource BrushAccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="No windows running" FontFamily="{DynamicResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                                   Text="Every window you launch shows up here as a live tile. Click a tile to play in it, or pause it to stop it drawing."/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                            <Button x:Name="LiveEmptyLaunch" Style="{StaticResource AccentButton}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="{DynamicResource IconSize13}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Launch a profile"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="LiveEmptyAccounts" Content="Pick accounts"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Always shown, stream mode or not, so a stream of this page says what it is and where to get it. -->
                            <Border x:Name="LiveBrand" Grid.Row="3" Margin="28,0,20,16" Padding="12,8,16,8" HorizontalAlignment="Left" Cursor="Hand"
                                    CornerRadius="{DynamicResource RadiusMd}" BorderThickness="1"
                                    Background="{DynamicResource BrushControl}" BorderBrush="{DynamicResource BrushControlStroke}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Lantern;component/Assets/lantern-256.png" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBrandTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="LiveBrandUrl" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource BrushAccentText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="LiveSide" Grid.Column="1" Width="272" Background="{DynamicResource BrushBackdropVeil}" BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <StackPanel x:Name="LiveSideBody" Margin="18,24,18,0"/>
                                    <StackPanel x:Name="LiveSideBody2" Margin="18,0,18,20"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===================== ERRORS ===================== -->
                    <Grid x:Name="PageErrors" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
