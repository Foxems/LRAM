                        </ScrollViewer>

                        <StackPanel x:Name="DlgAdd" Visibility="Collapsed" Margin="0,2,0,0">
                            <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource BrushControl}" BorderBrush="{DynamicResource BrushControlStroke}"
                                    BorderThickness="1" Padding="2" HorizontalAlignment="Left" Margin="0,8,0,0">
